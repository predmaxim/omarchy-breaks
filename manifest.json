{
  "schemaVersion": 1,
  "id": "predmaxim.breaks",
  "name": "Breaks",
  "version": "1.0.0",
  "author": "predmaxim",
  "description": "Breaks for the eyes and the body by active time; never during calls, video or meetings",
  "kinds": ["service", "bar-widget"],
  "entryPoints": { "service": "Service.qml", "barWidget": "Widget.qml" },
  "barWidget": {
    "displayName": "Breaks",
    "description": "Minutes to the next break",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {},
    "schema": [
      { "key": "strictness", "type": "enum", "label": "Strictness", "options": ["hard", "medium", "soft"], "defaultValue": "hard", "description": "hard: postpone only. medium: skipping breaks the streak. soft: skip freely. omarchy-shell predmaxim.breaks abort always ends a break." },
      { "key": "eyesMin", "type": "integer", "label": "Eye break: earliest, min", "min": 5, "max": 120, "step": 5, "defaultValue": 30 },
      { "key": "eyesMax", "type": "integer", "label": "Eye break: latest, min", "min": 5, "max": 180, "step": 5, "defaultValue": 50 },
      { "key": "eyesBreakSeconds", "type": "integer", "label": "Eye break length, s", "min": 20, "max": 600, "step": 10, "defaultValue": 90 },
      { "key": "bodyEvery", "type": "integer", "label": "Body break every, min", "min": 10, "max": 240, "step": 5, "defaultValue": 60 },
      { "key": "bodySeconds", "type": "integer", "label": "Body break length, s", "min": 60, "max": 1800, "step": 30, "defaultValue": 420 },
      { "key": "merge", "type": "integer", "label": "Join eyes into the body break within, min", "min": 0, "max": 60, "step": 5, "defaultValue": 15 },
      { "key": "microEnabled", "type": "boolean", "label": "Micro-pauses 20-20-20", "defaultValue": true },
      { "key": "microEvery", "type": "integer", "label": "Micro-pause every, min", "min": 5, "max": 60, "step": 5, "defaultValue": 20 },
      { "key": "microSeconds", "type": "integer", "label": "Micro-pause length, s", "min": 10, "max": 120, "step": 5, "defaultValue": 20 },
      { "key": "idleThreshold", "type": "integer", "label": "Idle after, s", "min": 10, "max": 600, "step": 10, "defaultValue": 60 },
      { "key": "postponeCount", "type": "integer", "label": "Postpones per break", "min": 0, "max": 10, "step": 1, "defaultValue": 2 },
      { "key": "postponeMinutes", "type": "integer", "label": "Postpone by, min", "min": 1, "max": 30, "step": 1, "defaultValue": 5 },
      { "key": "soundEnabled", "type": "boolean", "label": "Sounds", "defaultValue": true },
      { "key": "soundVolume", "type": "integer", "label": "Sound volume, %", "min": 0, "max": 100, "step": 5, "defaultValue": 50 },
      { "key": "calendar", "type": "boolean", "label": "Respect the calendar", "defaultValue": true },
      { "key": "meetingNudges", "type": "boolean", "label": "Movement tips during meetings", "defaultValue": false },
      { "key": "meetingNudgeEvery", "type": "integer", "label": "Meeting tip every, min", "min": 5, "max": 120, "step": 5, "defaultValue": 25 },
      { "key": "exclude", "type": "string", "label": "Never interrupt these apps", "defaultValue": "zoom,teams", "description": "Window classes, comma separated." },
      { "key": "debug", "type": "boolean", "label": "Debug", "defaultValue": false, "description": "Minutes become seconds; Super+Ctrl+Alt+Esc ends a break." }
    ]
  }
}
